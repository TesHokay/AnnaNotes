    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "~4.0.11",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.3"
